# Firebase Configuration
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-auth-domain.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-storage-bucket.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Google Sign-In (optional)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id

# Nunca pongas aquí claves secretas (de pago, de IA, de servidor): todo lo que está en este
# fichero se incluye en el paquete de la app y cualquiera puede extraerlo. Las claves privadas
# van como secretos de Firebase Functions (firebase functions:secrets:set).

# App Configuration
APP_ENV=development
API_TIMEOUT=30000
